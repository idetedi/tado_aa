# Copia este fichero a .env y ajusta lo que necesites. Todo es opcional:
# sin tocar nada, el script funciona con los valores que se ven aquí.
# .env está en .gitignore: no lo subas al repositorio.

# --- Funciones (true/false) -------------------------------------------------
ENABLE_GEOFENCING=true
ENABLE_OPEN_WINDOW=true
ENABLE_TEMP_LIMIT=true

# --- Límite de temperatura (ºC) ---------------------------------------------
MIN_TEMP=5
MAX_TEMP=25
# Hasta cuándo dura la corrección: NEXT_TIME_BLOCK (hasta el siguiente tramo
# del horario), MANUAL (hasta que la cambies tú) o TADO_MODE (hasta el
# siguiente cambio casa/fuera).
TEMP_LIMIT_OVERLAY_MODE=NEXT_TIME_BLOCK

# --- Cupo de la API de tado -------------------------------------------------
# Peticiones al día de tu cuenta: 100 sin Auto-Assist, 20000 con Auto-Assist.
# Si tado informa de otro valor en sus respuestas, se usa el de tado.
TADO_DAILY_LIMIT=100
# Peticiones que se guardan para arranques y para aplicar cambios.
TADO_REQUEST_RESERVE=10
# Segundos entre comprobaciones. 0 = calculado para no pasar del cupo.
CHECK_INTERVAL=0
# Horas en las que se comprueba. Fuera de ellas no se gasta ninguna petición
# y las comprobaciones del resto del día son más frecuentes. Ej.: 06:00-24:00
ACTIVE_HOURS=00:00-24:00
TZ=Europe/Madrid

# --- Modo simulación --------------------------------------------------------
# true = escribe en el log lo que haría, pero no cambia nada en tado.
DRY_RUN=false

# --- Avisos (vacío = desactivados) ------------------------------------------
# ntfy: URL completa del tema, p. ej. https://ntfy.midominio.es/tado
NTFY_URL=
NTFY_TOKEN=
# Telegram: token del bot (@BotFather) e id del chat. Van siempre juntos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = los avisos incluyen el nombre de los móviles que están en casa.
NOTIFY_DEVICE_NAMES=false

# --- Otros ------------------------------------------------------------------
# Nombres de las zonas para el log y los avisos: id=nombre separados por comas.
# Sin esto se muestran como "Zone 1", "Zone 2"...
ZONE_NAMES=
LOG_LEVEL=INFO
# Solo Docker: usuario y grupo del servidor dueños de ./data (id -u / id -g).
PUID=1000
PGID=1000
